{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bigu.app/schema/vocabulary.schema.json",
  "title": "Bigu vocabulary content",
  "description": "Shape of a data/vocabulary.json file, as loaded by vocabulary.js.",
  "type": "object",
  "required": ["updatedAt", "words"],
  "properties": {
    "updatedAt": {
      "type": "string",
      "format": "date",
      "description": "Last edit date, YYYY-MM-DD."
    },
    "words": {
      "type": "array",
      "items": { "$ref": "#/$defs/word" }
    }
  },
  "$defs": {
    "word": {
      "type": "object",
      "required": ["id", "kanji", "kana", "partOfSpeech", "meaning", "example"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique id, e.g. \"n3-001\". Used as the progress-store key."
        },
        "kanji": {
          "type": "string",
          "description": "Kanji spelling. Empty string for kana-only words (e.g. なるべく) — vocabulary.js treats an empty/absent value as \"no kanji\" and falls back to `kana` as the headword."
        },
        "kana": {
          "type": "string",
          "description": "Kana reading, always present."
        },
        "partOfSpeech": {
          "type": "string",
          "description": "e.g. \"noun\", \"verb\", \"adverb\"."
        },
        "meaning": {
          "type": "string",
          "description": "Mongolian meaning."
        },
        "example": { "$ref": "#/$defs/example" },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": ["N5", "N4", "N3", "N2", "N1", "Business", "Daily", "Travel", "Anime", "News"]
          },
          "description": "Facet tags for the vocabulary view's chip row: at most one JLPT level, plus any number of topics, e.g. [\"N2\", \"Business\"]. The JLPT tag is also what the card's .jlpt-tag badge shows. There is no file-level fallback — a word with no JLPT tag is unleveled, which is a valid and expected state, since the catalogue includes Japanese the exam does not cover (slang, drama lines, words met in the wild). vocabulary.js files those words under its \"Outside JLPT\" chip and draws no level badge on the card."
        }
      }
    },
    "example": {
      "type": "object",
      "required": ["jp", "reading", "mn"],
      "properties": {
        "jp": { "type": "string", "description": "Example sentence in Japanese script." },
        "reading": { "type": "string", "description": "Full sentence reading in hiragana." },
        "mn": { "type": "string", "description": "Mongolian translation." }
      }
    }
  },
  "examples": [
    {
      "updatedAt": "2026-08-02",
      "words": [
        {
          "id": "n2-000",
          "kanji": "見本",
          "kana": "みほん",
          "partOfSpeech": "noun",
          "meaning": "жишээ",
          "tags": ["N2"],
          "example": {
            "jp": "これは見本です。",
            "reading": "これはみほんです。",
            "mn": "Энэ бол жишээ юм."
          }
        },
        {
          "id": "n2-001",
          "kanji": "",
          "kana": "ぶっちゃけ",
          "partOfSpeech": "adverb",
          "meaning": "үнэнийг хэлэхэд",
          "tags": ["Daily"],
          "example": {
            "jp": "ぶっちゃけ、よく分からない。",
            "reading": "ぶっちゃけ、よくわからない。",
            "mn": "Үнэнийг хэлэхэд сайн ойлгохгүй байна."
          }
        }
      ]
    }
  ]
}
