{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bigu.app/schema/reading.schema.json",
  "title": "Bigu reading content",
  "description": "Shape of a data/reading.json file, as loaded by reading.js.",
  "type": "object",
  "required": ["updatedAt", "passages"],
  "properties": {
    "updatedAt": {
      "type": "string",
      "format": "date",
      "description": "Last edit date, YYYY-MM-DD."
    },
    "passages": {
      "type": "array",
      "items": { "$ref": "#/$defs/passage" }
    }
  },
  "$defs": {
    "passage": {
      "type": "object",
      "required": ["id", "title", "titleMn", "sentences"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique id, e.g. \"read-001\"."
        },
        "level": {
          "type": "string",
          "enum": ["N5", "N4", "N3", "N2", "N1"],
          "description": "This passage's own JLPT level, shown as its .jlpt-tag badge. Optional, and there is no file-level fallback — a passage without one is unleveled, which reading.js files under its \"Outside JLPT\" chip and renders with no badge."
        },
        "title": {
          "type": "string",
          "description": "Passage title in Japanese."
        },
        "titleMn": {
          "type": "string",
          "description": "Mongolian translation of the title."
        },
        "sentences": {
          "type": "array",
          "description": "The passage body, one sentence per entry. Keep passages short — a handful of sentences, not full articles.",
          "items": { "$ref": "#/$defs/sentence" }
        }
      }
    },
    "sentence": {
      "type": "object",
      "required": ["jp", "reading", "mn"],
      "properties": {
        "jp": { "type": "string", "description": "Sentence in Japanese script." },
        "reading": { "type": "string", "description": "Full sentence reading in hiragana." },
        "mn": { "type": "string", "description": "Mongolian translation." }
      }
    }
  },
  "examples": [
    {
      "updatedAt": "2026-08-02",
      "passages": [
        {
          "id": "read-000",
          "level": "N2",
          "title": "今日の天気",
          "titleMn": "Өнөөдрийн цаг агаар",
          "sentences": [
            {
              "jp": "今日は朝から雨が降っている。",
              "reading": "きょうはあさからあめがふっている。",
              "mn": "Өнөөдөр өглөөнөөс бороо орж байна."
            }
          ]
        }
      ]
    }
  ]
}
